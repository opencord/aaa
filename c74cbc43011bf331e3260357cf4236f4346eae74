    {
      "key": {
        "uuid": "ba092121_fec36736",
        "filename": "app/src/main/java/org/opencord/aaa/AaaConfig.java",
        "patchSetId": 3
      },
      "lineNbr": 44,
      "author": {
        "id": 1000034
      },
      "writtenOn": "2017-05-08T04:51:48Z",
      "side": 1,
      "message": "Why are you not able to use the socket? What is the need for this?  What is different in your topology when compared to other vendors that you are not able to use socket to reach the Radius server. The Radius Server is reachable via external Management VLAN. The linux kernel on the compute server is setup to be able to reach the external management.",
      "revId": "c74cbc43011bf331e3260357cf4236f4346eae74",
      "serverId": "2a2bfe1b-c5c2-48ed-9ac8-16438ab24388",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "ba092121_9e1d8b76",
        "filename": "app/src/main/java/org/opencord/aaa/AaaConfig.java",
